		frozenTrack.Priority = Enum.AnimationPriority.Action4
		frozenTrack.Looped = false 
		
		task.wait(frozenTrack.Length)
		
		frozenTrack:Stop()
		frozenTrack:RestoreAnimator()
		myHRP.Anchored = false
		
		CurrentCamera.CameraSubject = hum
		isAnimating = false
	end)
