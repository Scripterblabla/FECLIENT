-- Peningkatan sistem File & Asset Loader
local GetAsset = getcustomasset or getsynasset or (getgenv and (getgenv().getcustomasset or getgenv().getsynasset))
local isfile = isfile or (getgenv and getgenv().isfile) or function() return false end
local writefile = writefile or (getgenv and getgenv().writefile) or function() end
local readfile = readfile or (getgenv and getgenv().readfile) or function() return "" end

local function SafeDownload(fileName, url)
	local success, content = pcall(function()
		return game:HttpGet(url)
	end)
	if success and content and #content > 0 and not content:find("404: Not Found") then
		pcall(function()
			writefile(fileName, content)
		end)
		return true
	end
	return false
end

local function LoadAssetFromURL(fileName, url)
	if not isfile(fileName) or (#readfile(fileName) == 0) then
		SafeDownload(fileName, url)
	end

	if not isfile(fileName) then return nil end

	local objects
	local success = pcall(function()
		objects = game:GetObjects(GetAsset(fileName))
	end)

	if not success or not objects then
		if SafeDownload(fileName, url) then
			pcall(function()
				objects = game:GetObjects(GetAsset(fileName))
			end)
		end
	end

	if not objects then return nil end

	local kfSequence = nil
	local loadedFolder = Instance.new("Folder")
	loadedFolder.Name = "LoadedAssets_" .. fileName
	loadedFolder.Parent = workspace
	for _, obj in ipairs(objects) do
		obj.Parent = loadedFolder
		if obj:IsA("KeyframeSequence") then 
			kfSequence = obj 
		elseif obj:FindFirstChildWhichIsA("KeyframeSequence", true) then
			kfSequence = obj:FindFirstChildWhichIsA("KeyframeSequence", true)
		end
	end
	return kfSequence
end

local function LoadVFXFromURL(fileName, url)
	if not isfile(fileName) or (#readfile(fileName) == 0) then
		SafeDownload(fileName, url)
	end

	if not isfile(fileName) then return nil end

	local objects
	local success = pcall(function()
		objects = game:GetObjects(GetAsset(fileName))
	end)

	if not success or not objects then
		if SafeDownload(fileName, url) then
			pcall(function()
				objects = game:GetObjects(GetAsset(fileName))
			end)
		end
	end

	if not objects then return nil end

	local loadedFolder = Instance.new("Folder")
	loadedFolder.Name = "LoadedVFX_" .. fileName
	loadedFolder.Parent = game:GetService("ReplicatedStorage")
	for _, obj in ipairs(objects) do
		obj.Parent = loadedFolder
	end
	return loadedFolder
end

