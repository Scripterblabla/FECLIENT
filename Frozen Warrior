		local zoomOut = TweenService:Create(CurrentCamera, TweenInfo.new(track.Length * 0.75, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {FieldOfView = 100})
		local zoomIn = TweenService:Create(CurrentCamera, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {FieldOfView = originalFOV})
		
		zoomOut:Play()
		
		task.delay(track.Length - 0.4, function()
			zoomIn:Play()
			local lastEmit = vfxClone:FindFirstChild("LastEmitMeshes", true)
			if lastEmit me
				for _, mesh in ipairs(lastEmit:GetChildren()) do
					if mesh:IsA("BasePart") then
						mesh.Transparency = 0
						TweenService:Create(mesh, TweenInfo.new(0.4, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {
							Size = mesh.Size * 1.5,
							Transparency = 1
						}):Play()
					end
				end
			end
		end)
		
		task.wait(track.Length)
		
		track:Stop()
		track:RestoreAnimator()
		myHRP.Anchored = false
		
		CurrentCamera.FieldOfView = originalFOV
		CurrentCamera.CameraSubject = hum
		
		isAnimating = false
	end)
end

