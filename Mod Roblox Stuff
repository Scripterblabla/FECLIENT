local Players = game:GetService("Players")

local function ApplyMorph(Character)
    
    task.wait(0.5)

    
    local TargetTorso = Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso")
    
    if not TargetTorso or Character:FindFirstChild("ClientMorphApplied") then return end

    local Tag = Instance.new("BoolValue", Character)
    Tag.Name = "ClientMorphApplied"

    local Ball1 = Instance.new("Part", Character)
    Ball1.Size = Vector3.new(1.3, 1.3, 1.3)
    Ball1.Shape = Enum.PartType.Ball
    Ball1.BrickColor = BrickColor.new("Pastel brown")
    Ball1.TopSurface = Enum.SurfaceType.Smooth
    Ball1.BottomSurface = Enum.SurfaceType.Smooth

    local Ball1Weld = Instance.new("Weld", TargetTorso)
    Ball1Weld.Part0 = TargetTorso
    Ball1Weld.Part1 = Ball1
    Ball1Weld.C1 = CFrame.new(.5, -.3, .4)


    local Ball2 = Instance.new("Part", Character)
    Ball2.Size = Vector3.new(1.3, 1.3, 1.3)
    Ball2.Shape = Enum.PartType.Ball
    Ball2.BrickColor = BrickColor.new("Pastel brown")
    Ball2.TopSurface = Enum.SurfaceType.Smooth
    Ball2.BottomSurface = Enum.SurfaceType.Smooth

    local Ball2Weld = Instance.new("Weld", TargetTorso)
    Ball2Weld.Part0 = TargetTorso
    Ball2Weld.Part1 = Ball2
    Ball2Weld.C1 = CFrame.new(-.5, -.3, .4)


    local Ball3 = Instance.new("Part", Character)
    Ball3.Size = Vector3.new(.4, .4, .4)
    Ball3.Shape = Enum.PartType.Ball
    Ball3.BrickColor = BrickColor.new("Pink")
    Ball3.TopSurface = Enum.SurfaceType.Smooth
    Ball3.BottomSurface = Enum.SurfaceType.Smooth

    local Ball3Weld = Instance.new("Weld", TargetTorso)
    Ball3Weld.Part0 = TargetTorso
    Ball3Weld.Part1 = Ball3
    Ball3Weld.C1 = CFrame.new(-.5, -.3, .9)


    local Ball4 = Instance.new("Part", Character)
    Ball4.Size = Vector3.new(.4, .4, .4)
    Ball4.Shape = Enum.PartType.Ball
    Ball4.BrickColor = BrickColor.new("Pink")
    Ball4.TopSurface = Enum.SurfaceType.Smooth
    Ball4.BottomSurface = Enum.SurfaceType.Smooth

    local Ball4Weld = Instance.new("Weld", TargetTorso)
    Ball4Weld.Part0 = TargetTorso
    Ball4Weld.Part1 = Ball4
    Ball4Weld.C1 = CFrame.new(.5, -.3, .9)


    local Ball5 = Instance.new("Part", Character)
    Ball5.Size = Vector3.new(1.2, 1.2, 1.2)
    Ball5.Shape = Enum.PartType.Ball
    Ball5.BrickColor = BrickColor.new("Pastel brown")
    Ball5.TopSurface = Enum.SurfaceType.Smooth
    Ball5.BottomSurface = Enum.SurfaceType.Smooth

    local Ball5Weld = Instance.new("Weld", TargetTorso)
    Ball5Weld.Part0 = TargetTorso
    Ball5Weld.Part1 = Ball5
    Ball5Weld.C1 = CFrame.new(-.5, .9, -.4)


    local Ball6 = Instance.new("Part", Character)
    Ball6.Size = Vector3.new(1.2, 1.2, 1.2)
    Ball6.Shape = Enum.PartType.Ball
    Ball6.BrickColor = BrickColor.new("Pastel brown")
    Ball6.TopSurface = Enum.SurfaceType.Smooth
    Ball6.BottomSurface = Enum.SurfaceType.Smooth

    local Ball6Weld = Instance.new("Weld", TargetTorso)
    Ball6Weld.Part0 = TargetTorso
    Ball6Weld.Part1 = Ball6
    Ball6Weld.C1 = CFrame.new(.5, .9, -.4)
end

local function SetupPlayer(Player)
    if Player.Character then
        task.spawn(function()
            ApplyMorph(Player.Character)
        end)
    end
    Player.CharacterAdded:Connect(ApplyMorph)
end


for _, Player in ipairs(Players:GetPlayers()) do
    SetupPlayer(Player)
end


Players.PlayerAdded:Connect(SetupPlayer)
