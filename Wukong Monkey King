local function SetupTool3()
	local Backpack = LocalPlayer:WaitForChild("Backpack")
	if Backpack:FindFirstChild("Heavenly") or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Heavenly")) then return end
	
	local Tool = Instance.new("Tool")
	Tool.Name = "Heavenly"
	Tool.RequiresHandle = false
	Tool.Parent = Backpack

	Tool.Activated:Connect(function()
		if isAnimating or not HeavenlyAnim then return end
		local myChar = LocalPlayer.Character
		local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
		if not myHRP then return end

		isAnimating = true
		myHRP.Anchored = true
		
		local OriginalLighting = {}
		local LightingProps = {"Ambient", "Brightness", "ClockTime", "GeographicLatitude", "ColorShift_Top", "ColorShift_Bottom", "OutdoorAmbient"}
		for _, prop in ipairs(LightingProps) do
			OriginalLighting[prop] = Lighting[prop]
		end
		local OriginalFOV = CurrentCamera.FieldOfView
		
		Lighting.Ambient = Color3.fromRGB(138, 138, 138)
		Lighting.Brightness = 1
		Lighting.ClockTime = 12.302
		Lighting.GeographicLatitude = -0.41
		Lighting.ColorShift_Top = Color3.new(0, 0, 0)
		Lighting.ColorShift_Bottom = Color3.new(0, 0, 0)
		Lighting.OutdoorAmbient = Color3.fromRGB(70, 70, 70)
		
		CurrentCamera.FieldOfView = 1
		local fovTween = TweenService:Create(CurrentCamera, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {FieldOfView = 32.44})
		fovTween:Play()

		local camConn = nil

		task.spawn(function()
			pcall(function()
				loadstring(game:HttpGet("https://raw.githubusercontent.com/Scripterblabla/FECLIENT/refs/heads/main/Wukong%20Heavenly%20Camera"))()
			end)
		end)

		local track = PlayKeyframeSequence(myChar, HeavenlyAnim, 1)
		track.Priority = Enum.AnimationPriority.Action4
		track.Looped = false 

		local vfxClone = nil
		if HeavenlyVFX then
			vfxClone = HeavenlyVFX:Clone()
			vfxClone.Parent = workspace
			
			local throneRoom = vfxClone:FindFirstChild("ThroneRoom", true)
			local throneItself = vfxClone:FindFirstChild("ThroneItself", true)
			
			if throneItself then
				local pillar = throneItself:FindFirstChild("Pillar")
				if pillar then
					pillar:Destroy()
				end
			end
			
			for _, part in ipairs(vfxClone:GetDescendants()) do
				if part.Name:lower() == "bigpoll" then
					part:Destroy()
				end
			end
			
			if throneRoom then
                local spawnCF = myHRP.CFrame
				if throneRoom:IsA("Model") then
					throneRoom:PivotTo(spawnCF)
				elseif throneRoom:IsA("BasePart") then
					throneRoom.CFrame = spawnCF
				end
				
				local effectsFolder = throneRoom:FindFirstChild("effects", true)
				if effectsFolder then
					local camfx = effectsFolder:FindFirstChild("camfx")
					if camfx then
						local mainFX = camfx:FindFirstChild("main")
						if mainFX and mainFX:IsA("BasePart") then
							camConn = RunService.RenderStepped:Connect(function()
								if mainFX and mainFX.Parent then
									mainFX.CFrame = CurrentCamera.CFrame
								else
									if camConn then camConn:Disconnect() end
								end
							end)
						end
					end
				end
			end
			
			task.spawn(function()
				task.wait(1.5)
				if throneItself then
					local seatCF = myHRP.CFrame * CFrame.new(0, -1.2, 0.5) 
					if throneItself:IsA("Model") then
						throneItself:PivotTo(seatCF)
					elseif throneItself:IsA("BasePart") then
						throneItself.CFrame = seatCF
					end
				end
			end)
			
			Debris:AddItem(vfxClone, track.Length + 1)
		end
		
		task.wait(track.Length)
		
		if camConn then 
			camConn:Disconnect() 
		end
		
		track:Stop()
		track:RestoreAnimator()
		myHRP.Anchored = false
		
		for prop, value in pairs(OriginalLighting) do
			Lighting[prop] = value
		end
		TweenService:Create(CurrentCamera, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {FieldOfView = OriginalFOV}):Play()

		isAnimating = false
	end)
end

