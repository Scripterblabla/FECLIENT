local function SetupTool1()
	local Backpack = LocalPlayer:WaitForChild("Backpack")
	if Backpack:FindFirstChild("Forceful Prevention") or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Forceful Prevention")) then return end
	
	local Tool = Instance.new("Tool")
	Tool.Name = "Forceful Prevention"
	Tool.RequiresHandle = false
	Tool.Parent = Backpack

	Tool.Activated:Connect(function()
		if isAnimating or not ForcefulAnim then return end
		local myChar = LocalPlayer.Character
		local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
		if not myHRP then return end

		isAnimating = true
		myHRP.Anchored = true

		local track = PlayKeyframeSequence(myChar, ForcefulAnim, 1)
		track.Priority = Enum.AnimationPriority.Action4
		track.Looped = false 
		
		task.wait(track.Length)
		
		track:Stop()
		track:RestoreAnimator()
		myHRP.Anchored = false
		isAnimating = false
	end)
end

