local function SetupInosukeTool()
	local character = LocalPlayer.Character
	if character then
		AttachKatanaToCharacter(character)
	end

	local backpack = LocalPlayer:WaitForChild("Backpack")
	if backpack:FindFirstChild("Inosuke") or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Inosuke")) then return end

	local tool = Instance.new("Tool")
	tool.Name = "Inosuke"
	tool.RequiresHandle = false
	tool.Parent = backpack
	
	local isPlaying = false

	tool.Activated:Connect(function()
		if not InosukeAnim then 
			warn("Larping")
			return 
		end
		if isPlaying then return end

		local character = LocalPlayer.Character
		if not character then return end

		AttachKatanaToCharacter(character)

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local hrp = character:FindFirstChild("HumanoidRootPart")
		local head = character:FindFirstChild("Head")
		
		if not humanoid or not hrp or not head then return end

		isPlaying = true
		
		local originalSpeed = humanoid.WalkSpeed
		local originalJump = humanoid.JumpPower or 50
		humanoid.WalkSpeed = 0
		if humanoid.UseJumpPower then
			humanoid.JumpPower = 0
		else
			humanoid.JumpHeight = 0
		end
		
		local originalCamSubject = CurrentCamera.CameraSubject
		CurrentCamera.CameraSubject = head

		ToggleAttackVFX(character, true)
		
		if InosukeSFXAsset then
			local sfx = Instance.new("Sound")
			sfx.Name = "InosukeSFX"
			sfx.SoundId = InosukeSFXAsset
			sfx.Volume = 1
			sfx.RollOffMinDistance = 150
			sfx.RollOffMaxDistance = 100000
			sfx.Looped = false
			sfx.Parent = hrp

			task.spawn(function()
				if not sfx.IsLoaded then
					sfx.Loaded:Wait()
				end
				sfx:Play()
			end)

			task.delay(67, function()
				if sfx and sfx.Parent then
					sfx:Stop()
					sfx:Destroy()
				end
			end)

			sfx.Ended:Once(function()
				if sfx and sfx.Parent then
					sfx:Destroy()
				end
			end)
		end

		local animTrack = PlayKeyframeSequence(character, InosukeAnim, 1)
		animTrack.Priority = Enum.AnimationPriority.Action4
		animTrack.Looped = false
		animTrack:Play()

		task.delay(animTrack.Length, function()
			animTrack:Stop()
			
			ToggleAttackVFX(character, false)
			
			humanoid.WalkSpeed = originalSpeed
			if humanoid.UseJumpPower then
				humanoid.JumpPower = originalJump
			else
				humanoid.JumpHeight = 7.2
			end
			
			if originalCamSubject then
				CurrentCamera.CameraSubject = originalCamSubject
			end
			
			if not humanoid:FindFirstChild("Animator") then
				Instance.new("Animator", humanoid)
			end
			
			isPlaying = false
		end)
	end)
end

