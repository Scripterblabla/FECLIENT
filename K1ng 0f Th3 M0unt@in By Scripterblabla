local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local CurrentCamera = workspace.CurrentCamera

local EasingStyleMap = {
	[Enum.PoseEasingStyle.Linear]   = Enum.EasingStyle.Linear,
	[Enum.PoseEasingStyle.Bounce]   = Enum.EasingStyle.Bounce,
	[Enum.PoseEasingStyle.Cubic]    = Enum.EasingStyle.Cubic,
	[Enum.PoseEasingStyle.Elastic]  = Enum.EasingStyle.Elastic,
	[Enum.PoseEasingStyle.Constant] = Enum.EasingStyle.Linear,
}

local EasingDirectionMap = {
	[Enum.PoseEasingDirection.In]    = Enum.EasingDirection.In,
	[Enum.PoseEasingDirection.Out]   = Enum.EasingDirection.Out,
	[Enum.PoseEasingDirection.InOut] = Enum.EasingDirection.InOut,
}

local PriorityValue = {
	[Enum.AnimationPriority.Core]      = 0,
	[Enum.AnimationPriority.Idle]      = 1,
	[Enum.AnimationPriority.Movement]  = 2,
	[Enum.AnimationPriority.Action]    = 3,
	[Enum.AnimationPriority.Action2]   = 4,
	[Enum.AnimationPriority.Action3]   = 5,
	[Enum.AnimationPriority.Action4]   = 6,
}

local RigControllers = {}
local AnimationCache = {}

local function DestroyExistingAnimator(model)
	if not model then return end
	local anim = model:FindFirstChildWhichIsA("Animator")
	if anim then anim:Destroy() return end

	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		anim = hum:FindFirstChildWhichIsA("Animator")
		if anim then anim:Destroy() return end
	end

	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("Animator") then
			desc:Destroy()
			return
		end
	end
end

local function GetOrCreateController(model)
	if RigControllers[model] then return RigControllers[model] end

	local controller = { Tracks = {} }

	controller.Connection = RunService.Heartbeat:Connect(function()
		if not model or not model.Parent then
			if controller.Connection then controller.Connection:Disconnect() end
			RigControllers[model] = nil
			return
		end

		local now = os.clock()

		for _, track in ipairs(controller.Tracks) do
			if track.IsPlaying then
				local spd = track.Speed or 1
				local delta = (now - track._lastUpdateClock) * spd
				track._timePosition = track._timePosition + delta
				track._lastUpdateClock = now

				if track.Looped then
					if track.Length > 0 then
						track._timePosition = track._timePosition % track.Length
					end
				else
					if track._timePosition >= track.Length then
						track._timePosition = track.Length
						track.IsPlaying = false
					end
				end
			end
		end

		local jointContributions = {}

		for _, track in ipairs(controller.Tracks) do
			if track.IsPlaying and (track.Weight or 1) > 0 and track._jointData then
				local timePos = track._timePosition
				local tWeight = track.Weight or 1
				local tPrio = PriorityValue[track.Priority] or 3

				for jointName, poses in pairs(track._jointData) do
					if #poses == 0 then continue end

					local lastPose = poses[1]
					local nextPose = poses[1]
					for i = 1, #poses - 1 do
						if timePos >= poses[i].time and timePos < poses[i + 1].time then
							lastPose = poses[i]
							nextPose = poses[i + 1]
							break
						end
					end
					if timePos >= poses[#poses].time then
						lastPose = poses[#poses]
						nextPose = poses[#poses]
					end

					local alpha = 0
					if nextPose.time > lastPose.time then
						alpha = (timePos - lastPose.time) / (nextPose.time - lastPose.time)
					end

					local eased = TweenService:GetValue(alpha,
						EasingStyleMap[nextPose.style] or Enum.EasingStyle.Linear,
						EasingDirectionMap[nextPose.dir] or Enum.EasingDirection.InOut)

					local finalCF = lastPose.cframe:Lerp(nextPose.cframe, eased)

					if not jointContributions[jointName] then
						jointContributions[jointName] = {}
					end
					table.insert(jointContributions[jointName], {
						priority = tPrio, weight = tWeight, cframe = finalCF,
						joint = lastPose.joint, jtype = lastPose.jtype
					})
				end
			end
		end

		for jointName, contribs in pairs(jointContributions) do
			if #contribs == 0 then continue end

			local maxPrio = contribs[1].priority
			for _, c in ipairs(contribs) do if c.priority > maxPrio then maxPrio = c.priority end end

			local top = {}
			for _, c in ipairs(contribs) do if c.priority == maxPrio then table.insert(top, c) end end

			local finalCF
			if #top == 1 then
				finalCF = top[1].cframe
			else
				finalCF = top[1].cframe
				local wsum = top[1].weight
				for i = 2, #top do
					local c = top[i]
					local alpha = c.weight / (wsum + c.weight)
					finalCF = finalCF:Lerp(c.cframe, alpha)
					wsum = wsum + c.weight
				end
			end

			local sample = top[1]
			if sample.jtype == "Motor6D" or sample.jtype == "Bone" then
				sample.joint.Transform = finalCF
			end
		end
	end)

	RigControllers[model] = controller
	return controller
end

local function PlayKeyframeSequence(Model, KeyframeSequence, SpeedMult)
	SpeedMult = SpeedMult or 1
	if not Model or not KeyframeSequence then return nil end

	DestroyExistingAnimator(Model)

	local initialSpeed = SpeedMult
	local cached = AnimationCache[KeyframeSequence]
	local keyframes, rawLength, jointData

	if not cached then
		keyframes = {}
		for _, kf in ipairs(KeyframeSequence:GetKeyframes()) do
			table.insert(keyframes, {Time = kf.Time, KF = kf})
		end
		table.sort(keyframes, function(a,b) return a.Time < b.Time end)
		if #keyframes == 0 then return nil end
		rawLength = keyframes[#keyframes].Time
	else
		rawLength = cached.Length
	end

	if cached then
		local saved = cached.Data
		jointData = {}
		local motorMap = {}
		local boneMap = {}

		local function ResolveJoint(name)
			if motorMap[name] then return motorMap[name], "Motor6D" end
			if boneMap[name] then return boneMap[name], "Bone" end

			for _, v in ipairs(Model:GetDescendants()) do
				if v:IsA("Motor6D") and v.Part1 and v.Part1.Name == name then
					motorMap[name] = v
					return v, "Motor6D"
				elseif v:IsA("Bone") and v.Name == name then
					boneMap[name] = v
					return v, "Bone"
				end
			end
		end

		for jointName, poses in pairs(saved) do
			jointData[jointName] = {}
			for _, pose in ipairs(poses) do
				local joint, jtype = ResolveJoint(jointName)
				if joint then
					table.insert(jointData[jointName], {
						time = pose.time, cframe = pose.cframe,
						style = pose.style, dir = pose.dir,
						joint = joint, jtype = jtype
					})
				end
			end
		end
	else
		jointData = {}
		local motorMap = {}
		local boneMap = {}

		local function ResolveJoint(pose)
			local name = pose.Name
			if motorMap[name] then return motorMap[name], "Motor6D" end
			if boneMap[name] then return boneMap[name], "Bone" end

			for _, v in ipairs(Model:GetDescendants()) do
				if v:IsA("Motor6D") and v.Part1 and v.Part1.Name == name then
					motorMap[name] = v
					return v, "Motor6D"
				elseif v:IsA("Bone") and v.Name == name then
					boneMap[name] = v
					return v, "Bone"
				end
			end
		end

		for _, entry in ipairs(keyframes) do
			for _, pose in ipairs(entry.KF:GetDescendants()) do
				if pose:IsA("Pose") and pose.Weight > 0 then
					local joint, jtype = ResolveJoint(pose)
					if joint then
						if not jointData[pose.Name] then jointData[pose.Name] = {} end
						table.insert(jointData[pose.Name], {
							time = entry.Time, cframe = pose.CFrame,
							style = pose.EasingStyle, dir = pose.EasingDirection,
							joint = joint, jtype = jtype
						})
					end
				end
			end
		end

		local save = {}
		for jointName, poses in pairs(jointData) do
			save[jointName] = {}
			for _, pose in ipairs(poses) do
				table.insert(save[jointName], {
					time = pose.time, cframe = pose.cframe,
					style = pose.style, dir = pose.dir
				})
			end
		end

		AnimationCache[KeyframeSequence] = { Length = rawLength, Data = save }
	end

	local controller = GetOrCreateController(Model)
	local track = {
		Length = rawLength, Weight = 1, Priority = Enum.AnimationPriority.Action,
		Looped = true, IsPlaying = false, Speed = initialSpeed, Model = Model,
		_jointData = jointData, _timePosition = 0, _lastUpdateClock = os.clock(),

		Play = function(self, speed)
			if speed then self.Speed = speed end
			if not self.IsPlaying then self.IsPlaying = true; self._lastUpdateClock = os.clock() end
		end,
		Stop = function(self) self.IsPlaying = false end,
		AdjustSpeed = function(self, newSpeed) self.Speed = newSpeed or 1 end,
		SetTimePosition = function(self, t) self._timePosition = math.clamp(t or 0, 0, self.Length) end,
		GetTimePosition = function(self) return self._timePosition end,
		RestoreAnimator = function(self)
			local m = self.Model
			if not m then return nil end
			local existing = m:FindFirstChildWhichIsA("Animator")
			if existing then return existing end
			local hum = m:FindFirstChildOfClass("Humanoid")
			if hum then
				existing = hum:FindFirstChildWhichIsA("Animator")
				if existing then return existing end
			end
			local animator = Instance.new("Animator")
			animator.Parent = hum or m
			return animator
		end,
	}

	setmetatable(track, {
		__index = function(self, k) if k == "TimePosition" then return self._timePosition end return rawget(self, k) end,
		__newindex = function(self, k, v)
			if k == "TimePosition" then self._timePosition = math.clamp(v or 0, 0, self.Length) else rawset(self, k, v) end
		end,
	})

	table.insert(controller.Tracks, track)
	track.IsPlaying = true
	track._lastUpdateClock = os.clock()

	return track
end

getgenv().PlayKeyframeSequence = PlayKeyframeSequence

local GetAsset = getcustomasset or getsynasset
local isfile = isfile or function(file) return false end
local writefile = writefile or function(file, data) end

local function LoadAssetFromURL(fileName, url)
	if not isfile(fileName) then writefile(fileName, game:HttpGet(url)) end
	local objects = game:GetObjects(GetAsset(fileName))
	local kfSequence = nil
	local loadedFolder = Instance.new("Folder")
	loadedFolder.Name = "LoadedAssets_" .. fileName
	loadedFolder.Parent = workspace
	for _, obj in ipairs(objects) do
		obj.Parent = loadedFolder
		if obj:IsA("KeyframeSequence") then 
			kfSequence = obj 
		elseif obj:FindFirstChildWhichIsA("KeyframeSequence", true) then
			kfSequence = obj:FindFirstChildWhichIsA("KeyframeSequence", true)
		end
	end
	return kfSequence
end

local function LoadModelFromURL(fileName, url)
	if not isfile(fileName) then writefile(fileName, game:HttpGet(url)) end
	local objects = game:GetObjects(GetAsset(fileName))
	if #objects == 0 then return nil end

	for _, obj in ipairs(objects) do
		if obj.Name == "Katana" or obj:FindFirstChild("BladeL") or obj:FindFirstChild("BladeR") then
			return obj
		end
	end

	if #objects == 1 then
		return objects[1]
	else
		local folder = Instance.new("Folder")
		folder.Name = "Katana"
		for _, obj in ipairs(objects) do
			obj.Parent = folder
		end
		return folder
	end
end

local InosukeAnim = nil
local KatanaModelL = nil
local KatanaModelR = nil
local InosukeSFXAsset = nil

local function CleanNametags(parent)
	if not parent then return end
	for _, desc in ipairs(parent:GetDescendants()) do
		local lowerName = string.lower(desc.Name)
		if string.find(lowerName, "nametag") 
			or string.find(lowerName, "tag") 
			or desc:IsA("BillboardGui") 
			or desc:IsA("SurfaceGui") 
			or (desc:IsA("TextLabel") and not desc:IsDescendantOf(Players.LocalPlayer:FindFirstChild("PlayerGui")))
		then
			pcall(function() desc:Destroy() end)
		end
	end
end

local function SetupVFX(parent)
	if not parent then return end
	for _, desc in ipairs(parent:GetDescendants()) do
		if desc:IsA("Trail") or desc:IsA("ParticleEmitter") or desc:IsA("Beam") then
			desc.Enabled = false
		end
	end
end

local function ToggleAttackVFX(character, state)
	local katanaSys = character:FindFirstChild("KatanaSystem")
	if katanaSys then
		for _, desc in ipairs(katanaSys:GetDescendants()) do
			if desc:IsA("Trail") or desc:IsA("ParticleEmitter") or desc:IsA("Beam") then
				if state and desc:IsA("ParticleEmitter") then
					desc:Clear()
				end
				desc.Enabled = state
			end
		end
	end
end

local function GetBladeContainer(katanaFolder, bladeName)
	if not katanaFolder then return nil end
	
	for _, child in ipairs(katanaFolder:GetChildren()) do
		if child.Name == bladeName and child:IsA("Model") then return child end
	end
	for _, desc in ipairs(katanaFolder:GetDescendants()) do
		if desc.Name == bladeName and desc:IsA("Model") then return desc end
	end
	
	return katanaFolder:FindFirstChild(bladeName)
end

local function AttachKatanaToCharacter(character)
	if not character or (not KatanaModelL and not KatanaModelR) then return end
	if character:FindFirstChild("KatanaEquippedTag") then return end 

	local rightArm = character:FindFirstChild("Right Arm") or character:FindFirstChild("RightHand")
	local leftArm = character:FindFirstChild("Left Arm") or character:FindFirstChild("LeftHand")
	local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("HumanoidRootPart")

	if not rightArm or not leftArm or not torso then return end 

	local tag = Instance.new("BoolValue")
	tag.Name = "KatanaEquippedTag"
	tag.Parent = character

	local katanaSystem = Instance.new("Folder")
	katanaSystem.Name = "KatanaSystem"
	katanaSystem.Parent = character
	
	local targetCF = character.PrimaryPart and character.PrimaryPart.CFrame or torso.CFrame

	local function SetupBlade(bladeModel, armPart, jointName)
		if not bladeModel then return end
		
		CleanNametags(bladeModel)
		SetupVFX(bladeModel)

		local mainPart = bladeModel:FindFirstChild("HumanoidRootPart") 
			or bladeModel:FindFirstChild(jointName) 
			or bladeModel:FindFirstChildWhichIsA("BasePart")

		if not mainPart then return end

		for _, part in ipairs(bladeModel:GetDescendants()) do
			if part:IsA("BasePart") and part ~= mainPart then
				local hasJoint = false
				for _, j in ipairs(bladeModel:GetDescendants()) do
					if (j:IsA("Weld") or j:IsA("WeldConstraint") or j:IsA("Motor6D")) and (j.Part0 == part or j.Part1 == part) then
						hasJoint = true
						break
					end
				end
				if not hasJoint then
					local weld = Instance.new("WeldConstraint")
					weld.Name = "AutoWeld_" .. part.Name
					weld.Part0 = mainPart
					weld.Part1 = part
					weld.Parent = mainPart
				end
			end
		end

		for _, oldMotor in ipairs(armPart:GetChildren()) do
			if oldMotor:IsA("Motor6D") and oldMotor.Name == jointName then
				oldMotor:Destroy()
			end
		end

		local motor = Instance.new("Motor6D")
		motor.Name = jointName
		motor.Part0 = armPart
		motor.Part1 = mainPart
		motor.C0 = CFrame.new(0, -0.8, -3.0) * CFrame.Angles(math.rad(-90), 0, 0)
		motor.C1 = CFrame.new()
		motor.Parent = armPart
	end

	if KatanaModelL then
		local cloneL = KatanaModelL:Clone()
		if cloneL:IsA("Model") then cloneL:PivotTo(targetCF) end
		cloneL.Parent = katanaSystem
		local bladeL = GetBladeContainer(cloneL, "BladeL") or cloneL
		SetupBlade(bladeL, leftArm, "BladeL")
	end

	if KatanaModelR then
		local cloneR = KatanaModelR:Clone()
		if cloneR:IsA("Model") then cloneR:PivotTo(targetCF) end
		cloneR.Parent = katanaSystem
		local bladeR = GetBladeContainer(cloneR, "BladeR") or cloneR
		SetupBlade(bladeR, rightArm, "BladeR")
	end

	for _, desc in ipairs(katanaSystem:GetDescendants()) do
		if desc:IsA("BasePart") then
			desc.Anchored = false
			desc.CanCollide = false
			desc.CanTouch = false
			desc.CanQuery = false
			desc.Massless = true
			if desc.Name == "HumanoidRootPart" then
				desc.Transparency = 1
			end
		end
	end
end

